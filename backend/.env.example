# Server Configuration
PORT=3000
NODE_ENV=production

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# API Key Secret (generate with: openssl rand -base64 32)
API_KEY_SECRET=your-api-key-secret-change-this-in-production

# Redis Configuration
# Format: redis://[username]:[password]@[host]:[port]
# Local: redis://localhost:6379
# With password: redis://:password@localhost:6379
# Upstash: redis://default:token@endpoint.upstash.io:6379
REDIS_URL=redis://localhost:6379

# Admin Panel Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Lobby Configuration
LOBBY_HEARTBEAT_TIMEOUT_MS=30000
LOBBY_MAX_INACTIVE_MS=60000
